<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tg_bg">

    <ImageView
        android:id="@+id/iv_lock_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30F172A"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:paddingTop="80dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="安全验证"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请完成验证"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:layout_marginBottom="30dp"/>

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#801E293B"
                android:hint="请输入安全密码"
                android:inputType="textPassword"
                android:padding="15dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:layout_marginBottom="20dp"
                android:visibility="gone"/>

            <com.mocitianxia.ai.LockPatternView
                android:id="@+id/lockPatternView"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btn_action"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/tg_blue"
                android:text="确认"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_fingerprint"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="30dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_fingerprint"
                android:visibility="gone"
                android:alpha="0.8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="指纹解锁" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>